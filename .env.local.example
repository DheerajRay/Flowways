# FlowWays local environment template
# Copy this file to `.env.local` and fill values.
# PowerShell: Copy-Item .env.local.example .env.local

# ------------------------------
# Git / GitHub (optional for local app runtime; useful for release tooling)
# ------------------------------
# How to pull:
# 1) Repo URL: run `git remote get-url origin`
# 2) Personal Access Token (classic or fine-grained):
#    GitHub -> Settings -> Developer settings -> Personal access tokens
# 3) GitHub username: your GitHub account handle
GITHUB_REPO_URL=https://github.com/<your-org-or-user>/<repo>.git

# ------------------------------
# Supabase (required)
# ------------------------------
# How to pull:
# 1) Go to Supabase project dashboard
# 2) Project Settings -> API
# 3) Copy:
#    - Project URL -> NEXT_PUBLIC_SUPABASE_URL
#    - anon public key -> NEXT_PUBLIC_SUPABASE_ANON_KEY
# 4) (Optional) service_role key for server admin jobs only
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------
# OpenAI (required for AI classification)
# ------------------------------
# How to pull:
# 1) OpenAI platform -> API keys
# 2) Create a new secret key
# 3) Paste into OPENAI_API_KEY
# 4) Optional: choose model used by classifier route
OPENAI_API_KEY=
OPENAI_CLASSIFIER_MODEL=gpt-4.1-mini

# ------------------------------
# Optional reminder/email providers (future)
# ------------------------------
REMINDER_PROVIDER_API_KEY=
